{
  "id": "related-keywords-v1",
  "provider": "dataforseo",
  "mode": "sync",
  "description": "Returns Google \"searches related to\" keywords for one seed keyword with search volume, CPC, competition, keyword difficulty (0-100), optional intent, 12-month history and the upstream related-keyword depth; key inputs are keyword, location_name, language_code, depth (default 2, range 0-4), limit (default 100, max 1000), and offset; billed at DataForSEO cost, up to $0.12 per call.",
  "endpoint": "https://api.dataforseo.com/v3/dataforseo_labs/google/related_keywords/live",
  "method": "POST",
  "auth": {
    "type": "basic",
    "secret_ref": "CAPABILITY_DATAFORSEO_LOGIN",
    "password_ref": "CAPABILITY_DATAFORSEO_PASSWORD"
  },
  "request": {
    "required": [
      "keyword"
    ],
    "body_wrap": "array",
    "body": {
      "keyword": "$.input.keyword",
      "location_name": "$.input.location_name",
      "language_code": "$.input.language_code",
      "depth": "$.input.depth",
      "limit": "$.input.limit",
      "offset": "$.input.offset"
    },
    "defaults": {
      "location_name": "United States",
      "language_code": "en",
      "depth": 2,
      "limit": 100,
      "offset": 0
    },
    "ranges": {
      "depth": {
        "min": 0,
        "max": 4,
        "integer": true
      },
      "limit": {
        "min": 1,
        "max": 1000,
        "integer": true
      },
      "offset": {
        "min": 0,
        "integer": true
      }
    },
    "consts": {
      "include_serp_info": false,
      "include_clickstream_data": false
    }
  },
  "response": {
    "success": {
      "path": "$.tasks.0.status_code",
      "values": [
        20000
      ],
      "failure_code": "upstream_task_failed",
      "non_empty": "$.tasks.0.result.0.items",
      "empty_ok": true
    },
    "collections": {
      "keywords": {
        "path": "$.tasks.0.result.0.items",
        "field_paths": {
          "keyword": "$.keyword_data.keyword",
          "search_volume": "$.keyword_data.keyword_info.search_volume",
          "cpc": "$.keyword_data.keyword_info.cpc",
          "competition": "$.keyword_data.keyword_info.competition_level",
          "keyword_difficulty": "$.keyword_data.keyword_properties.keyword_difficulty",
          "intent": "$.keyword_data.search_intent_info.main_intent",
          "monthly_searches": "$.keyword_data.keyword_info.monthly_searches",
          "depth": "$.depth"
        }
      }
    },
    "error_code_path": "$.tasks.0.status_code",
    "error_map": {
      "400": {
        "code": "invalid_request",
        "http_status": 400,
        "message": "The upstream data service rejected the request parameters."
      },
      "401": {
        "code": "upstream_unavailable",
        "http_status": 503,
        "message": "The upstream data service is temporarily unavailable.",
        "log_code": "upstream_authentication"
      },
      "40100": {
        "code": "upstream_unavailable",
        "http_status": 503,
        "message": "The upstream data service is temporarily unavailable.",
        "log_code": "upstream_authentication"
      },
      "40200": {
        "code": "upstream_unavailable",
        "http_status": 503,
        "message": "The upstream data service is temporarily unavailable.",
        "log_code": "upstream_balance_unavailable"
      },
      "40210": {
        "code": "upstream_unavailable",
        "http_status": 503,
        "message": "The upstream data service is temporarily unavailable.",
        "log_code": "upstream_balance_unavailable"
      },
      "40202": {
        "code": "upstream_rate_limited",
