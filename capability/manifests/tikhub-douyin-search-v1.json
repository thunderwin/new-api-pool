{
  "id": "douyin-search-v1",
  "manifest_version": "1.0.0",
  "provider": "tikhub",
  "mode": "sync",
  "http_adapter": "tikhub-douyin-search",
  "description": "Search Douyin videos by keyword. Empty video pages are free.",
  "endpoint": "https://api.tikhub.io/api/v1/douyin/search/fetch_video_search_v2",
  "method": "POST",
  "auth": {"type": "bearer", "secret_ref": "TIKHUB_API_KEY"},
  "request": {
    "content_type": "application/json",
    "required": ["keyword"],
    "body": {
      "keyword": "$.input.keyword",
      "cursor": "$.input.cursor",
      "search_id": "$.input.search_id"
    },
    "defaults": {"cursor": 0, "search_id": ""},
    "consts": {
      "sort_type": "0",
      "publish_time": "0",
      "filter_duration": "0",
      "content_type": "1",
      "backtrace": ""
    }
  },
  "response": {
    "success": {"path": "$.code", "values": [200], "failure_code": "upstream_response_failed"},
    "error_map": {
      "400": {"code": "invalid_request", "http_status": 400, "message": "upstream rejected the search request"},
      "422": {"code": "invalid_request", "http_status": 400, "message": "upstream rejected the search request"},
      "401": {"code": "upstream_unavailable", "http_status": 503, "message": "upstream service is unavailable", "log_code": "upstream_authentication"},
      "429": {"code": "upstream_rate_limited", "http_status": 429, "message": "upstream is rate limited"},
      "500": {"code": "upstream_unavailable", "http_status": 503, "message": "upstream service is unavailable"}
    }
  },
  "billing": {"type": "per_call", "unit": "call", "price_usd": 0.01},
  "limits": {"timeout": "30s", "max_response_bytes": 8388608, "disable_redirects": true},
  "retry": {"attempts": 1, "retry_on": []}
}
