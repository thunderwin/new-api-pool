{
  "id": "web-unlock-v1",
  "provider": "brightdata",
  "mode": "sync",
  "description": "Fetch a public Wayfair page through Bright Data Web Unlocker.",
  "endpoint": "https://api.brightdata.com/request",
  "method": "POST",
  "auth": {
    "type": "bearer",
    "secret_ref": "CAPABILITY_BRIGHTDATA_API_KEY"
  },
  "request": {
    "content_type": "application/json",
    "required": ["url"],
    "url_inputs": {
      "url": {
        "allowed_hosts": [
          "wayfair.com",
          "wayfair.ca",
          "wayfair.co.uk",
          "wayfair.de"
        ]
      }
    },
    "body": {
      "url": "$.input.url"
    },
    "consts": {
      "format": "json"
    },
    "env": {
      "zone": "CAPABILITY_BRIGHTDATA_ZONE"
    }
  },
  "response": {
    "status_header": "x-brd-status-code",
    "error_header": "x-brd-error",
    "success": {
      "path": "$.status_code",
      "values": [200],
      "non_empty": "$.body",
      "failure_code": "upstream_target_status",
      "empty_code": "upstream_empty_body"
    },
    "output": {
      "status": "$.status_code",
      "html": "$.body"
    }
  },
  "billing": {
    "type": "per_call",
    "unit": "call",
    "price_usd": 0.003
  },
  "limits": {
    "timeout": "90s",
    "max_response_bytes": 8388608
  },
  "retry": {
    "attempts": 2,
    "retry_on": [429, 502, 503, 504]
  }
}
