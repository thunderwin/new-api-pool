{
  "id": "keyword-volume-v1",
  "provider": "aisa",
  "mode": "sync",
  "description": "Returns monthly search volume, CPC, competition, optional search intent, and 12-month history for 1-200 keywords; customize location_name and language_code; billed by actual upstream usage, up to $0.16 per call.",
  "endpoint": "https://api.aisa.one/apis/v1/dataforseo/dataforseo_labs/google/keyword_overview/live",
  "method": "POST",
  "auth": {
    "type": "bearer",
    "secret_ref": "CAPABILITY_AISA_API_KEY"
  },
  "request": {
    "required": [
      "keywords"
    ],
    "body_wrap": "array",
    "body": {
      "keywords": "$.input.keywords",
      "location_name": "$.input.location_name",
      "language_code": "$.input.language_code"
    },
    "defaults": {
      "location_name": "United States",
      "language_code": "en"
    },
    "array_lengths": {
      "keywords": {
        "min": 1,
        "max": 200
      }
    },
    "consts": {
      "include_serp_info": false,
      "include_clickstream_data": false
    },
    "headers": {
      "X-AISA-Max-Price-USD": "0.16"
    }
  },
  "response": {
    "success": {
      "path": "$.tasks.0.status_code",
      "values": [
        20000
      ],
      "failure_code": "upstream_task_failed"
    },
    "collections": {
      "keywords": {
        "path": "$.tasks.0.result.0.items",
        "field_paths": {
          "keyword": "$.keyword",
          "search_volume": "$.search_volume",
          "cpc": "$.cpc",
          "competition": "$.competition",
          "intent": "$.search_intent_info.main_intent",
          "monthly_searches": "$.monthly_searches"
        }
      }
    },
    "error_code_path": "$.error.code",
    "error_map": {
      "400": {
        "code": "invalid_request",
        "http_status": 400,
        "message": "The upstream data service rejected the request parameters."
      },
      "401": {
        "code": "upstream_unavailable",
        "http_status": 503,
        "message": "The upstream data service is temporarily unavailable.",
        "log_code": "upstream_authentication"
      },
      "authentication_unavailable": {
        "code": "upstream_unavailable",
        "http_status": 503,
        "message": "The upstream data service is temporarily unavailable.",
        "log_code": "upstream_authentication_unavailable"
      },
      "insufficient_wallet_balance": {
        "code": "upstream_unavailable",
        "http_status": 503,
        "message": "The upstream data service is temporarily unavailable.",
        "log_code": "upstream_wallet_balance"
      },
      "insufficient_api_key_balance": {
        "code": "upstream_unavailable",
        "http_status": 503,
        "message": "The upstream data service is temporarily unavailable.",
        "log_code": "upstream_api_key_balance"
      },
      "estimated_price_exceeds_max_price": {
        "code": "cost_cap_exceeded",
        "http_status": 422,
        "message": "The estimated upstream cost exceeds the per-request cap; reduce the keyword count and try again.",
        "log_code": "upstream_cost_cap_exceeded"
      },
      "402": {
        "code": "upstream_unavailable",
        "http_status": 503,
        "message": "The upstream data service is temporarily unavailable.",
        "log_code": "upstream_balance_unavailable"
      },
      "429": {
        "code": "upstream_rate_limited",
        "http_status": 429,
        "message": "The upstream data service is rate limited; retry later.",
        "log_code": "upstream_rate_limited"
      },
      "502": {
        "code": "upstream_unavailable",
        "http_status": 503,
        "message": "The upstream data service is temporarily unavailable.",
        "log_code": "upstream_provider_failure"
      },
      "503": {
        "code": "upstream_unavailable",
        "http_status": 503,
        "message": "The upstream data service is temporarily unavailable.",
        "log_code": "upstream_unavailable"
      }
    }
  },
  "billing": {
    "type": "per_unit",
    "unit": "micro_usd",
    "price_usd": 0.000001,
    "quantity_header": "X-AISA-Customer-Cost-Micros-USD",
    "reserve_usd": 0.16
  },
  "limits": {
    "timeout": "90s",
    "max_response_bytes": 8388608
  },
  "retry": {
    "attempts": 2,
    "retry_on": [
      429,
      503
    ]
  }
}
