{
  "id": "keyword-volume-v1",
  "provider": "dataforseo",
  "mode": "sync",
  "description": "Returns search volume, CPC, competition, keyword difficulty (0-100), optional intent, and 12-month history for 1-200 keywords; customize keywords, location_name, and language_code; billed at DataForSEO cost, up to $0.04 per call.",
  "endpoint": "https://api.dataforseo.com/v3/dataforseo_labs/google/keyword_overview/live",
  "method": "POST",
  "auth": {
    "type": "basic",
    "secret_ref": "CAPABILITY_DATAFORSEO_LOGIN",
    "password_ref": "CAPABILITY_DATAFORSEO_PASSWORD"
  },
  "request": {
    "required": [
      "keywords"
    ],
    "body_wrap": "array",
    "body": {
      "keywords": "$.input.keywords",
      "location_name": "$.input.location_name",
      "language_code": "$.input.language_code"
    },
    "defaults": {
      "location_name": "United States",
      "language_code": "en"
    },
    "array_lengths": {
      "keywords": {
        "min": 1,
        "max": 200
      }
    },
    "consts": {
      "include_serp_info": false,
      "include_clickstream_data": false
    }
  },
  "response": {
    "success": {
      "path": "$.tasks.0.status_code",
      "values": [
        20000
      ],
      "failure_code": "upstream_task_failed"
    },
    "collections": {
      "keywords": {
        "path": "$.tasks.0.result.0.items",
        "field_paths": {
          "keyword": "$.keyword",
          "search_volume": "$.keyword_info.search_volume",
          "cpc": "$.keyword_info.cpc",
          "competition": "$.keyword_info.competition_level",
          "keyword_difficulty": "$.keyword_properties.keyword_difficulty",
          "intent": "$.search_intent_info.main_intent",
          "monthly_searches": "$.keyword_info.monthly_searches"
        }
      }
    },
    "error_code_path": "$.tasks.0.status_code",
    "error_map": {
      "400": {
        "code": "invalid_request",
        "http_status": 400,
        "message": "The upstream data service rejected the request parameters."
      },
      "401": {
        "code": "upstream_unavailable",
        "http_status": 503,
        "message": "The upstream data service is temporarily unavailable.",
        "log_code": "upstream_authentication"
      },
      "40100": {
        "code": "upstream_unavailable",
        "http_status": 503,
        "message": "The upstream data service is temporarily unavailable.",
        "log_code": "upstream_authentication"
      },
      "40200": {
        "code": "upstream_unavailable",
        "http_status": 503,
        "message": "The upstream data service is temporarily unavailable.",
        "log_code": "upstream_balance_unavailable"
      },
      "40210": {
        "code": "upstream_unavailable",
        "http_status": 503,
        "message": "The upstream data service is temporarily unavailable.",
        "log_code": "upstream_balance_unavailable"
      },
      "40202": {
        "code": "upstream_rate_limited",
        "http_status": 429,
        "message": "The upstream data service is rate limited; retry later.",
        "log_code": "upstream_rate_limited"
      },
      "40209": {
        "code": "upstream_rate_limited",
        "http_status": 429,
        "message": "The upstream data service is rate limited; retry later.",
        "log_code": "upstream_rate_limited"
      },
      "402": {
        "code": "upstream_unavailable",
        "http_status": 503,
        "message": "The upstream data service is temporarily unavailable.",
        "log_code": "upstream_balance_unavailable"
      },
      "429": {
        "code": "upstream_rate_limited",
        "http_status": 429,
        "message": "The upstream data service is rate limited; retry later.",
        "log_code": "upstream_rate_limited"
      },
      "40501": {
        "code": "invalid_request",
        "http_status": 400,
        "message": "The upstream data service rejected the request parameters."
      },
      "40503": {
        "code": "invalid_request",
        "http_status": 400,
        "message": "The upstream data service rejected the request parameters."
      },
      "40506": {
        "code": "invalid_request",
        "http_status": 400,
        "message": "The upstream data service rejected the request parameters."
      },
      "500": {
        "code": "upstream_unavailable",
        "http_status": 503,
        "message": "The upstream data service is temporarily unavailable.",
        "log_code": "upstream_provider_failure"
      },
      "50000": {
        "code": "upstream_unavailable",
