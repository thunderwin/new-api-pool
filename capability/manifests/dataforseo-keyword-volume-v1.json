        "log_code": "upstream_timeout"
      }
    }
  },
  "billing": {
    "type": "per_unit",
    "unit": "usd",
    "price_usd": 1,
    "quantity_path": "$.cost",
    "reserve_usd": 0.04
  },
  "limits": {
    "timeout": "90s",
    "max_response_bytes": 8388608
  },
  "retry": {
    "attempts": 2,
    "retry_on": [
      429,
      503
    ]
  }
}
