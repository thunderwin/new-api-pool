        "log_code": "upstream_unavailable"
      },
      "503": {
        "code": "upstream_unavailable",
        "http_status": 503,
        "message": "The upstream data service is temporarily unavailable.",
        "log_code": "upstream_unavailable"
      },
      "50303": {
        "code": "upstream_unavailable",
