{
  "id": "ai-answer-chatgpt-v1",
  "provider": "dataforseo",
  "mode": "sync",
  "description": "Asks Chatgpt one buyer question and returns the model answer with the cited sources, fan-out queries, search results, and token usage; customize prompt, model, web_search, web_search_country_iso_code, web_search_city, system_message, temperature; billed at DataForSEO cost, up to $0.20 per call.",
  "endpoint": "https://api.dataforseo.com/v3/ai_optimization/chat_gpt/llm_responses/live",
  "method": "POST",
  "auth": {
    "type": "basic",
    "secret_ref": "CAPABILITY_DATAFORSEO_LOGIN",
    "password_ref": "CAPABILITY_DATAFORSEO_PASSWORD"
  },
  "request": {
    "required": [
      "prompt"
    ],
    "body_wrap": "array",
    "body": {
      "user_prompt": "$.input.prompt",
      "model_name": "$.input.model",
      "web_search": "$.input.web_search",
      "web_search_country_iso_code": "$.input.web_search_country_iso_code",
      "web_search_city": "$.input.web_search_city",
      "system_message": "$.input.system_message",
      "temperature": "$.input.temperature"
    },
    "defaults": {
      "model_name": "gpt-6-sol",
      "web_search": true,
      "web_search_country_iso_code": "US"
    },
    "ranges": {
      "temperature": {
        "min": 0,
        "max": 2
      }
    }
  },
  "response": {
    "success": {
      "path": "$.tasks.0.status_code",
      "values": [
        20000
      ],
      "failure_code": "upstream_task_failed"
    },
    "output": {
      "result": "$.tasks.0.result"
    },
    "error_code_path": "$.tasks.0.status_code",
    "error_map": {
      "400": {
        "code": "invalid_request",
        "http_status": 400,
        "message": "The upstream data service rejected the request parameters."
      },
      "401": {
        "code": "upstream_unavailable",
        "http_status": 503,
        "message": "The upstream data service is temporarily unavailable.",
        "log_code": "upstream_authentication"
      },
      "40100": {
        "code": "upstream_unavailable",
        "http_status": 503,
        "message": "The upstream data service is temporarily unavailable.",
        "log_code": "upstream_authentication"
      },
      "40200": {
        "code": "upstream_unavailable",
        "http_status": 503,
        "message": "The upstream data service is temporarily unavailable.",
        "log_code": "upstream_balance_unavailable"
      },
      "40210": {
        "code": "upstream_unavailable",
        "http_status": 503,
        "message": "The upstream data service is temporarily unavailable.",
        "log_code": "upstream_balance_unavailable"
      },
      "40202": {
        "code": "upstream_rate_limited",
        "http_status": 429,
        "message": "The upstream data service is rate limited; retry later.",
        "log_code": "upstream_rate_limited"
      },
      "40209": {
        "code": "upstream_rate_limited",
        "http_status": 429,
        "message": "The upstream data service is rate limited; retry later.",
        "log_code": "upstream_rate_limited"
      },
      "402": {
        "code": "upstream_unavailable",
        "http_status": 503,
        "message": "The upstream data service is temporarily unavailable.",
        "log_code": "upstream_balance_unavailable"
      },
      "429": {
        "code": "upstream_rate_limited",
        "http_status": 429,
        "message": "The upstream data service is rate limited; retry later.",
        "log_code": "upstream_rate_limited"
      },
      "40501": {
        "code": "invalid_request",
        "http_status": 400,
        "message": "The upstream data service rejected the request parameters."
      },
      "40503": {
        "code": "invalid_request",
        "http_status": 400,
        "message": "The upstream data service rejected the request parameters."
      },
      "40506": {
        "code": "invalid_request",
        "http_status": 400,
        "message": "The upstream data service rejected the request parameters."
      },
      "500": {
        "code": "upstream_unavailable",
        "http_status": 503,
        "message": "The upstream data service is temporarily unavailable.",
        "log_code": "upstream_provider_failure"
      },
      "50000": {
        "code": "upstream_unavailable",
        "http_status": 503,
        "message": "The upstream data service is temporarily unavailable.",
        "log_code": "upstream_provider_failure"
      },
      "503": {
        "code": "upstream_unavailable",
        "http_status": 503,
        "message": "The upstream data service is temporarily unavailable.",
        "log_code": "upstream_unavailable"
      },
      "50301": {
        "code": "upstream_unavailable",
        "http_status": 503,
        "message": "The upstream data service is temporarily unavailable.",
        "log_code": "upstream_unavailable"
      },
      "50303": {
        "code": "upstream_unavailable",
        "http_status": 503,
        "message": "The upstream data service is temporarily unavailable.",
        "log_code": "upstream_unavailable"
      },
      "50304": {
        "code": "upstream_unavailable",
        "http_status": 503,
        "message": "The upstream data service is temporarily unavailable.",
        "log_code": "upstream_unavailable"
      },
      "50401": {
        "code": "upstream_timeout",
        "http_status": 504,
        "message": "The upstream data service timed out; retry later.",
        "log_code": "upstream_timeout"
      }
    }
  },
  "billing": {
    "type": "per_unit",
    "unit": "usd",
    "price_usd": 1,
    "quantity_path": "$.cost",
    "reserve_usd": 0.2
  },
  "limits": {
    "timeout": "150s",
    "max_response_bytes": 8388608
  },
  "retry": {
    "attempts": 2,
    "retry_on": [
      429,
      503
    ]
  }
}
