{
  "id": "ssl-analyze-v1",
  "provider": "ssllabs",
  "mode": "async",
  "description": "SSL Labs host analysis (free asynchronous API, no key).",
  "submit": {
    "endpoint": "https://api.ssllabs.com/api/v3/analyze",
    "method": "GET",
    "query": {
      "host": "$.input.host"
    },
    "consts": {
      "all": "done"
    },
    "job_id_path": "$.host"
  },
  "poll": {
    "endpoint": "https://api.ssllabs.com/api/v3/analyze",
    "method": "GET",
    "query": {
      "host": "$.input.host"
    },
    "consts": {
      "all": "done"
    },
    "status_path": "$.status",
    "success_values": ["READY"],
    "failure_values": ["ERROR"],
    "result_path": "$.endpoints"
  },
  "billing": {
    "type": "per_call",
    "price_usd": 0
  },
  "limits": {
    "timeout": "30s",
    "max_response_bytes": 2097152
  },
  "retry": {
    "attempts": 1,
    "retry_on": [429, 502, 503, 504]
  },
  "idempotency": {
    "header": "Idempotency-Key",
    "ttl": "24h"
  }
}
