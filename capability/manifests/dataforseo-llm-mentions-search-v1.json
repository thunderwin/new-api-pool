{
  "id": "llm-mentions-search-v1",
  "provider": "dataforseo",
  "mode": "sync",
  "description": "Searches the AI mentions database for the questions whose answers mention a target domain or keyword, returning answers, sources, search results, and ai search volume; customize target (1-10 entities), platform, location_code, language_code, limit (default 20), order_by, and filters; billed at DataForSEO cost, up to $0.25 per call.",
  "endpoint": "https://api.dataforseo.com/v3/ai_optimization/llm_mentions/search/live",
  "method": "POST",
  "auth": {
    "type": "basic",
    "secret_ref": "CAPABILITY_DATAFORSEO_LOGIN",
    "password_ref": "CAPABILITY_DATAFORSEO_PASSWORD"
  },
  "request": {
    "required": [
      "target"
    ],
    "body_wrap": "array",
    "body": {
      "target": "$.input.target",
      "platform": "$.input.platform",
      "location_code": "$.input.location_code",
      "language_code": "$.input.language_code",
      "limit": "$.input.limit",
      "order_by": "$.input.order_by",
      "filters": "$.input.filters"
    },
    "defaults": {
      "platform": "chat_gpt",
      "location_code": 2840,
      "language_code": "en",
      "limit": 20
    },
    "ranges": {
      "limit": {
        "min": 1,
        "max": 100,
        "integer": true
      }
    },
    "array_lengths": {
      "target": {
        "min": 1,
        "max": 10
      },
      "order_by": {
        "min": 1,
        "max": 3
      },
      "filters": {
        "min": 1,
        "max": 8
      }
    },
    "enums": {
      "platform": [
        "chat_gpt",
        "google"
      ]
    }
  },
  "response": {
    "success": {
      "path": "$.tasks.0.status_code",
      "values": [
        20000
      ],
      "failure_code": "upstream_task_failed"
    },
    "output": {
      "result": "$.tasks.0.result"
    },
    "error_code_path": "$.tasks.0.status_code",
    "error_map": {
      "400": {
        "code": "invalid_request",
        "http_status": 400,
        "message": "The upstream data service rejected the request parameters."
      },
      "401": {
        "code": "upstream_unavailable",
        "http_status": 503,
        "message": "The upstream data service is temporarily unavailable.",
        "log_code": "upstream_authentication"
      },
      "40100": {
        "code": "upstream_unavailable",
        "http_status": 503,
        "message": "The upstream data service is temporarily unavailable.",
        "log_code": "upstream_authentication"
      },
      "40200": {
        "code": "upstream_unavailable",
        "http_status": 503,
        "message": "The upstream data service is temporarily unavailable.",
        "log_code": "upstream_balance_unavailable"
      },
      "40210": {
        "code": "upstream_unavailable",
        "http_status": 503,
        "message": "The upstream data service is temporarily unavailable.",
        "log_code": "upstream_balance_unavailable"
      },
      "40202": {
        "code": "upstream_rate_limited",
        "http_status": 429,
        "message": "The upstream data service is rate limited; retry later.",
        "log_code": "upstream_rate_limited"
      },
      "40209": {
        "code": "upstream_rate_limited",
        "http_status": 429,
        "message": "The upstream data service is rate limited; retry later.",
        "log_code": "upstream_rate_limited"
      },
      "402": {
        "code": "upstream_unavailable",
        "http_status": 503,
        "message": "The upstream data service is temporarily unavailable.",
        "log_code": "upstream_balance_unavailable"
      },
      "429": {
        "code": "upstream_rate_limited",
        "http_status": 429,
        "message": "The upstream data service is rate limited; retry later.",
        "log_code": "upstream_rate_limited"
      },
      "40501": {
        "code": "invalid_request",
        "http_status": 400,
        "message": "The upstream data service rejected the request parameters."
      },
      "40503": {
        "code": "invalid_request",
        "http_status": 400,
        "message": "The upstream data service rejected the request parameters."
      },
      "40506": {
        "code": "invalid_request",
        "http_status": 400,
        "message": "The upstream data service rejected the request parameters."
      },
      "500": {
        "code": "upstream_unavailable",
        "http_status": 503,
        "message": "The upstream data service is temporarily unavailable.",
        "log_code": "upstream_provider_failure"
      },
      "50000": {
        "code": "upstream_unavailable",
        "http_status": 503,
        "message": "The upstream data service is temporarily unavailable.",
        "log_code": "upstream_provider_failure"
      },
      "503": {
        "code": "upstream_unavailable",
        "http_status": 503,
        "message": "The upstream data service is temporarily unavailable.",
        "log_code": "upstream_unavailable"
      },
      "50301": {
        "code": "upstream_unavailable",
        "http_status": 503,
        "message": "The upstream data service is temporarily unavailable.",
        "log_code": "upstream_unavailable"
      },
      "50303": {
        "code": "upstream_unavailable",
        "http_status": 503,
        "message": "The upstream data service is temporarily unavailable.",
        "log_code": "upstream_unavailable"
      },
      "50304": {
        "code": "upstream_unavailable",
        "http_status": 503,
        "message": "The upstream data service is temporarily unavailable.",
        "log_code": "upstream_unavailable"
      },
      "50401": {
        "code": "upstream_timeout",
        "http_status": 504,
        "message": "The upstream data service timed out; retry later.",
        "log_code": "upstream_timeout"
      }
    }
  },
  "billing": {
    "type": "per_unit",
    "unit": "usd",
    "price_usd": 1,
    "quantity_path": "$.cost",
    "reserve_usd": 0.25
  },
  "limits": {
    "timeout": "90s",
    "max_response_bytes": 8388608
  },
  "retry": {
    "attempts": 2,
    "retry_on": [
      429,
      503
    ]
  }
}
